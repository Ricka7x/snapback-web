# .env.local.example - Template for sensitive local configuration
#
# Copy this file to .env.local and fill in your values.
# .env.local is in .gitignore and will never be committed.
# It is sourced automatically by config.sh — no manual export needed.
#

# ============================================================================
# NOTARIZATION
# ============================================================================

# Keychain profile created with:
#   xcrun notarytool store-credentials "snapback-notary" \
#     --apple-id you@example.com --team-id XXXXXXXXXX --password xxxx-xxxx-xxxx-xxxx
export NOTARY_PROFILE="snapback-notary"

# ============================================================================
# SPARKLE
# ============================================================================

# Path to Sparkle binaries (generate_appcast, sign_update)
# Found in Xcode DerivedData after building with Sparkle as a package dependency
export SPARKLE_BIN="$HOME/Library/Developer/Xcode/DerivedData/Snapback-XXXXXXXXXX/SourcePackages/artifacts/sparkle/Sparkle/bin"

# Path to EdDSA private key for signing releases
# IMPORTANT: Never commit this file!
# export SPARKLE_ED_KEY_FILE="$HOME/.sparkle/snapback_private.pem"

# ============================================================================
# OVERRIDES (optional)
# ============================================================================

# Override download URL for staging
# export DOWNLOAD_URL_PREFIX="https://staging.snapbackapp.com/releases"

# Override temp build directory
# export BUILD_DIR="$HOME/builds/snapback"

# Verbose output
# export VERBOSE="true"
